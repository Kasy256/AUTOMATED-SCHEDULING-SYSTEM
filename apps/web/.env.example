# Build-time settings (Vite inlines them into the bundle; never put secrets here).
# Origin of the API when it runs on another host, e.g. https://api.example.com. Empty locally: Vite proxies /api.
VITE_API_BASE_URL=
# Error reporting (the web project's public DSN; empty disables it), environment and release tags.
VITE_SENTRY_DSN=
VITE_DEPLOY_ENV=local
VITE_RELEASE=
