# docker compose (local only)
POSTGRES_PASSWORD=change-me-superuser
CARTLYF_OWNER_PASSWORD=change-me-owner
CARTLYF_APP_PASSWORD=change-me-app
# Host ports; change them if 5432/6379 are already taken on your machine.
CARTLYF_POSTGRES_PORT=5432
CARTLYF_REDIS_PORT=6379

# local | test | staging | production. Staging and production refuse to start with dev-only values
# (insecure cookie or S3, http URLs, console email, no Sentry DSN).
CARTLYF_ENVIRONMENT=local

# API and worker: connect as the non-superuser app role
CARTLYF_DATABASE_URL=postgresql+asyncpg://cartlyf_app:change-me-app@127.0.0.1:5432/cartlyf
CARTLYF_REDIS_URL=redis://127.0.0.1:6379/0
CARTLYF_LOG_LEVEL=INFO
# Connect/query timeout for the API and worker database connections.
CARTLYF_DB_TIMEOUT_SECONDS=5

# Alembic only: connects as the schema owner
CARTLYF_MIGRATION_DATABASE_URL=postgresql+asyncpg://cartlyf_owner:change-me-owner@127.0.0.1:5432/cartlyf

# Auth. JWT secret: at least 32 random chars, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
CARTLYF_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Base URL of the web app, used for links in emails.
CARTLYF_WEB_BASE_URL=http://localhost:5173
# Public base URL of this API, used in calendar feed links handed to calendar apps.
CARTLYF_PUBLIC_API_BASE_URL=http://localhost:8000
# The refresh cookie is Secure by default; set false only for plain-http local dev.
CARTLYF_COOKIE_SECURE=false
# Access tokens live in memory; refresh tokens rotate in an httpOnly cookie.
# CARTLYF_ACCESS_TOKEN_MINUTES=15
# CARTLYF_REFRESH_TOKEN_DAYS=30
CARTLYF_AUTH_RATE_LIMIT_PER_MINUTE=10
# Calendar feed (.ics) requests per client IP per minute.
CARTLYF_FEED_RATE_LIMIT_PER_MINUTE=60

# Object storage (S3 API). Local: the MinIO container from docker compose. Production: Cloudflare R2.
CARTLYF_S3_ENDPOINT=127.0.0.1:9000
CARTLYF_S3_ACCESS_KEY=change-me-minio-user
CARTLYF_S3_SECRET_KEY=change-me-minio-password
CARTLYF_S3_BUCKET=cartlyf
CARTLYF_S3_SECURE=false
# Region name for the S3 API; Cloudflare R2 uses auto.
# CARTLYF_S3_REGION=
CARTLYF_MINIO_PORT=9000
# CSV import limits
CARTLYF_IMPORT_MAX_BYTES=5000000
CARTLYF_IMPORT_MAX_ROWS=20000

# Solve jobs: time limits (seconds), solver threads and per-organisation concurrency
CARTLYF_SOLVE_DEFAULT_TIME_LIMIT_S=60
CARTLYF_SOLVE_MAX_TIME_LIMIT_S=600
CARTLYF_SOLVE_NUM_WORKERS=4
CARTLYF_SOLVE_MAX_CONCURRENT_PER_ORG=2
# Worker heartbeat cadence; a running solve silent for the stale window is marked failed.
CARTLYF_SOLVE_HEARTBEAT_SECONDS=1
CARTLYF_SOLVE_STALE_AFTER_SECONDS=30
# A queued solve not started within this window is marked failed.
CARTLYF_SOLVE_QUEUE_TIMEOUT_SECONDS=3600
# Most assignment changes accepted in one draft edit.
CARTLYF_DRAFT_MAX_CHANGES=1000
# Seconds the worker spends explaining an infeasible solve and testing relaxations
CARTLYF_INFEASIBILITY_TIME_LIMIT_S=30
# Alternatives one "why is this here?" request checks at most (bounds its CPU time)
CARTLYF_EXPLAIN_MAX_ALTERNATIVES=100
# Error reporting; optional locally, required in staging and production.
# CARTLYF_SENTRY_DSN=
# Release tag for Sentry; on Render it defaults to RENDER_GIT_COMMIT.
# CARTLYF_RELEASE=

# Email: console logs whole messages (local only); resend sends through the Resend API.
CARTLYF_EMAIL_PROVIDER=console
# CARTLYF_RESEND_API_KEY=
# CARTLYF_RESEND_API_URL=https://api.resend.com
# CARTLYF_EMAIL_FROM=Cartlyf <no-reply@example.com>
